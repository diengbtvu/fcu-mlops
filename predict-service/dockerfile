FROM python:3.11

# Create non-root user
RUN groupadd --gid 1000 apigroup \
    && useradd --uid 1000 --gid apigroup \
       --shell /bin/bash --create-home apiuser

# curl is used by the container HEALTHCHECK below
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install dependencies as root
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && python -c "import shap"

# Copy application files and set ownership
COPY --chown=apiuser:apigroup . .

# app/mlruns is gitignored (created at runtime by MLflow), so it doesn't exist in this
# COPY and Docker would otherwise create the hydrogen_mlflow_runs volume mount point
# owned by root on first use - apiuser can't write to it, so every mlflow.start_run()
# fails silently and mlflow_run_id stays NULL forever (model never shows up as
# available for prediction). Pre-create it here so the ownership carries over.
RUN mkdir -p /app/app/mlruns && chown apiuser:apigroup /app/app/mlruns

# Switch to non-root user
USER apiuser

EXPOSE 5000

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=6 \
    CMD curl -fsS http://127.0.0.1:5000/predict/health || exit 1

# Single worker because training is CPU/memory intensive and should be processed
# sequentially. Timeout is generous (30 min): the /train request runs training,
# saves the model back to Laravel synchronously, and only then hands off to a
# background thread for the (Groq-rate-limited, can be slow) report - 180s was
# tight enough that gunicorn would kill the worker mid-request under any real
# slowness in that synchronous part, which looks like an abrupt "502 bad gateway"
# to the client instead of the request just taking a while.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--timeout", "1800", "run:app"]
