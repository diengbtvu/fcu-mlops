FROM python:3.11

# Create non-root user
RUN groupadd --gid 1000 apigroup \
    && useradd --uid 1000 --gid apigroup \
       --shell /bin/bash --create-home apiuser

WORKDIR /app

# Copy requirements and install dependencies as root
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && python -c "import shap"

# Copy application files and set ownership
COPY --chown=apiuser:apigroup . .

# Switch to non-root user
USER apiuser

EXPOSE 5000

# Run gunicorn with a longer timeout and a single worker because training is
# CPU/memory intensive and should be processed sequentially.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--timeout", "180", "run:app"]
