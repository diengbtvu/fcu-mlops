FROM php:8.2-fpm

# Install system dependencies
# libfcgi-bin provides cgi-fcgi, used for the container healthcheck since
# php-fpm has no HTTP listener of its own (see php-fpm healthcheck pool config below).
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libfcgi-bin \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    libzip-dev

# Clear cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install \
    pdo \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip

# Install composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Create system user to run Composer and Artisan Commands
RUN groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid appgroup \
       --shell /bin/bash --create-home appuser

WORKDIR /var/www/html

# Copy application files
COPY --chown=appuser:appgroup . .

# Set proper permissions
RUN chown -R appuser:appgroup /var/www/html \
    && chmod -R 755 /var/www/html \
    && chmod -R 775 /var/www/html/storage \
    && chmod -R 775 /var/www/html/bootstrap/cache

# Switch to non-root user for installation
USER appuser

# Install composer dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Switch back to root to fix permissions before running
USER root

# Ensure proper permissions for runtime
RUN chown -R appuser:appgroup /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

# Enable the FPM ping/status endpoints so the container has a real healthcheck
# target despite php-fpm not speaking HTTP directly.
RUN { \
      echo 'ping.path = /ping'; \
      echo 'ping.response = pong'; \
      echo 'pm.status_path = /status'; \
    } > /usr/local/etc/php-fpm.d/zz-healthcheck.conf

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
    CMD SCRIPT_NAME=/ping SCRIPT_FILENAME=/ping REQUEST_METHOD=GET \
        cgi-fcgi -bind -connect 127.0.0.1:9000 | grep -q pong || exit 1

# Switch back to appuser
USER appuser

# Expose port 9000 and start php-fpm
EXPOSE 9000
CMD ["php-fpm"]
