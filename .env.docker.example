APP_NAME="Hydrogen Production Rate Prediction"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=http://localhost:52025
# Optional override for deployments on public IP/domain
# Example: http://203.0.113.10:52025 or https://your-domain.com
PUBLIC_APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Docker MySQL Configuration
# IMPORTANT: These must match docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=laravel_user
DB_PASSWORD=LaravelSecurePass2025!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Prediction Service Configuration
# This must point to the predict-service container
PREDICT_SERVICE_URL=http://predict-service:5000
PREDICT_SERVICE_PUBLIC_URL=http://localhost:5000
# Browser-facing base URL for predict-service requests.
# Leave empty to route browser traffic through the same-origin nginx proxy.
PREDICT_SERVICE_BROWSER_URL=
# Optional override for browser access to predict-service
# Example: http://203.0.113.10:5000
PUBLIC_PREDICT_SERVICE_URL=
PREDICTION_SERVICE_URL=http://predict-service:5000

# API Configuration (for predict-service)
JWT_SECRET=your_jwt_secret_change_in_production
MODEL_DIR=app/ml_model
PREDICT_PORT=5000
REPORT_LLM_PROVIDER=ollama
BENCHMARK_LLM_CLIENT=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REPORT_MODEL=gemma4:e4b
OLLAMA_BENCHMARK_MODEL=gemma4:e4b
OLLAMA_BENCHMARK_NUM_CTX=65536
OLLAMA_BENCHMARK_TIMEOUT_SECONDS=420
OLLAMA_BENCHMARK_DISABLE_THINKING=1
OLLAMA_BENCHMARK_GENERATION_NUM_PREDICT=2200
OLLAMA_BENCHMARK_JSON_NUM_PREDICT=4096
OLLAMA_BENCHMARK_RETRY_BACKOFF_SECONDS=4
OLLAMA_BENCHMARK_RETRY_JITTER_SECONDS=0.5
BENCHMARK_TIMEOUT_SECONDS=10800
BENCHMARK_SECONDS_PER_GENERATION=90
OPENAI_REPORT_MODEL=gpt-5.2
OPENAI_API_KEY=

# Security
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
