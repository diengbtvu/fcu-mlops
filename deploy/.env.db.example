# Copy to deploy/.env.db and fill in real values. Used only by docker-compose.db.yml
# and by deploy.sh (to authenticate mysqldump for the pre-deploy backup).
# NEVER commit the real file.

NET_EXTERNAL=hydrogen_net
VOLUME_PREFIX=hydrogen
MYSQL_MEM_LIMIT=1g

MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_DATABASE=laravel_db
MYSQL_USER=laravel_user
MYSQL_PASSWORD=REPLACE_ME
