# Copy to deploy/.env.blue and fill in real values. NEVER commit the real file
# (deploy/.gitignore already excludes .env.blue / .env.green / .env.db).
#
# DB_*, JWT_SECRET, GROQ_* must be IDENTICAL between .env.blue and .env.green: both
# colors share the same MySQL database and the same JWT signing secret (tokens issued
# by one color must be valid on the other during the switch window).

# --- Color identity (the only things that should differ from .env.green) ---
COLOR=green
COMPOSE_PROJECT_NAME=hydrogen-green

# --- Registry / images (same on every color) ---
REGISTRY=ghcr.io/diengbtvu
IMAGE_PREFIX=fcu-mlops

# --- Shared infra names (same on every color; must match docker-compose.db.yml,
#     the shared edge proxy's network attachment, and the one-time `docker network
#     create` / `docker volume create` bootstrap - see deploy/README.md) ---
NET_EXTERNAL=hydrogen_net
VOLUME_PREFIX=hydrogen

# --- Resource limits (tune to your server) ---
NGINX_MEM_LIMIT=128m
WEBAPP_MEM_LIMIT=768m
PREDICT_MEM_LIMIT=3g

# --- Laravel ---
APP_NAME=Hydrogen Production Rate Prediction
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_--show
APP_URL=https://zettix.net
LOG_CHANNEL=stack
LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Shared MySQL (must match deploy/.env.db) ---
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=laravel_user
DB_PASSWORD=REPLACE_ME

# --- Shared secrets ---
JWT_SECRET=REPLACE_ME

# --- predict-service ---
MODEL_DIR=app/ml_model
PREDICT_PORT=5000
PREDICT_SERVICE_PUBLIC_URL=
REPORT_LLM_PROVIDER=groq
BENCHMARK_LLM_CLIENT=groq
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_BENCHMARK_MODEL=openai/gpt-oss-120b
